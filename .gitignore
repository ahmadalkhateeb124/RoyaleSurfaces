# Logs (contain user contact info — never commit)
uploads/mail.log
*.log

# Production credentials (never commit)
inc/mail.credentials.php
inc/db.credentials.php
BusinessPortal/config/database.credentials.php
BusinessPortal/config/mail.credentials.php

# Database dumps (contain hashed passwords, contact data)
*.sql
!BusinessPortal/config/schema.sql

# Generated on demand by BusinessPortal/seo.php ("Regenerate" button) — a local
# snapshot the admin panel reads back to show its own age/URL count. The live
# /sitemap.xml route always serves sitemap.php's output regardless of this
# file's presence, so committing a copy only risks it going stale in the repo.
sitemap.xml

# OS / editor noise
.DS_Store
.idea/
.vscode/
Thumbs.db

# Composer (vendor folders are committed; lock files and cache aren't)
**/.composer-cache/
